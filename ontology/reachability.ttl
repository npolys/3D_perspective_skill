@prefix :     <https://w3id.org/spatial-cognition#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:ReachableLocation a owl:Class ;
    rdfs:subClassOf :Concept ;
    rdfs:label "Reachable location"@en ;
    rdfs:comment "A place the agent can get to through traversable space, with a travel time of path length divided by speed."@en .
