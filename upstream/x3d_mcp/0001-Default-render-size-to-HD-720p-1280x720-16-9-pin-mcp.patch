-    "mcp>=1.7",
+    "mcp>=1.7,<2",  # mcp 2.x renamed FastMCP to MCPServer; src/ imports mcp.server.fastmcp
     "x3d>=4.0.65.5,<5",
     "lxml>=6.0",
